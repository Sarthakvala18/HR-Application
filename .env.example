# HR App — credential reference (SAFE TO COMMIT: names only, no values)
# Real values live in .env, which is gitignored.

# --- App ---
APP_KEY=                       # php artisan key:generate. ROTATING THIS BREAKS ENCRYPTED BANK FIELDS.
APP_URL=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Zoho (Sign + Desk + One) ---
# Access tokens last 1 hour. A self-client REFRESH token is required for the app.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com
ZOHO_SIGN_TEMPLATE_FREELANCE=  # template_id (not the request id)

# --- Slack (token rotation enabled: access token expires ~12h) ---
SLACK_USER_TOKEN=              # xoxe.xoxp-...
SLACK_REFRESH_TOKEN=           # xoxe-1-...
SLACK_CLIENT_ID=               # required to exchange the refresh token
SLACK_CLIENT_SECRET=           # required to exchange the refresh token
SLACK_BOT_TOKEN=               # xoxb-... for posting announcements
SLACK_CHANNEL_CHAMPIONS=
SLACK_CHANNEL_HR=

# --- Typeform ---
TYPEFORM_TOKEN=
TYPEFORM_WEBHOOK_SECRET=
TYPEFORM_FORM_PAPERWORK=WcuWNmoI
TYPEFORM_FORM_BANK=jmmVWSoj
TYPEFORM_FORM_LEAVE=r4773u

# --- Zoom (Server-to-Server OAuth) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Manual apps (no credentials; consoles only, for task-card links) ---
GOOGLE_ADMIN_CONSOLE_URL=https://admin.google.com
BITWARDEN_CONSOLE_URL=https://vault.internal.example
